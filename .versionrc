{
  "header": "# Changelog\n\nAll notable changes to this project are documented here.\n\nThe format follows [Keep a Changelog](https://keepachangelog.com/en/1.1.0/), and\nthis project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\nThis file is generated: `pixi run automation changelog` renders it from the\nconventional commits with `convco`, and `pixi run automation changelog_check`\nfails when the committed copy has drifted. Edit the commit messages, not the\nfile.\n\n",
  "types": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "refactor", "section": "Changed" },
    { "type": "revert", "section": "Removed" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
